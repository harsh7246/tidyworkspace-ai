{
  "manifest_version": 3,
  "name": "TidyWorkspace AI",
  "description": "AI-powered tab grouping and download renaming. Bring your own API key (Gemini, OpenAI, Claude, or DeepSeek).",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "downloads",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TidyWorkspace AI"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
